classDiagram
    %% Перечисления (Enums)
    class ГруппаКрови {
        <<enumeration>>
        A
        B
        AB
        O
    }

    %% Основные классы
    class Человек {
        ГруппаКрови группаКрови
        Пальцы: int = 10
        Говорить()
        Спать()
    }

    class Дерево {
        ДиапазонЦветовРастения: String
        ВозрастРастения: int
        СбрасыватьЛиству()
        Фотосинтезировать()
    }

    class Берёза {
        ДиаметрСердцевины: int
    }

    class Ствол {
        Кольца: int
        ПередаватьВеществаКроне()
    }

    class Корень {
        ПротяжённостьСистемы: int
        ВсасыватьВещества()
        ПоддерживатьЖизньРастения()
    }

    class Лист {
        Жилки: int
        Фотосинтезировать()
    }

    class Дятел {
        ДлинаКлюва: int
        Пальцы: int = 4
        Спать()
        ЕстьПаразитов()
    }

    %% Связи (Relationships)

    %% Наследование (Обобщение)
    Берёза --|> Дерево

    %% Композиция (3 раза, часть не может существовать без целого)
    Дерево *-- "1" Ствол : состоит из
    Дерево *-- "1..*" Корень : имеет корневую систему
    Дерево *-- "0..*" Лист : имеет листья (сезонно)

    %% Ассоциация (Дятел знает о дереве, но они независимы)
    Дятел --> Дерево : долбит

    %% Направленная ассоциация "высаживает"
    Человек --> Дерево : высаживает
